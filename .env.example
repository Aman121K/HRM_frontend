# Platform API (HRM_backend). Locally: http://localhost:4100. Production: https://api.<your-domain>
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:4100
# Root domain for brand sign-in subdomains (<brand>.<APP_DOMAIN>). Locally: localhost
NEXT_PUBLIC_APP_DOMAIN=localhost
# Company SSO (optional). Leave empty to use built-in email + password sign-in.
NEXT_PUBLIC_OIDC_ISSUER=
# Server-side copy used for the Content-Security-Policy connect-src.
OIDC_ISSUER=
# Local development only — MUST be false (or unset) in every deployed environment.
NEXT_PUBLIC_ALLOW_DEMO_IDENTITY=false
# Demo identities for the "View as" switcher (local development only).
# NEXT_PUBLIC_DEMO_EMPLOYEE_ID=BT002
# NEXT_PUBLIC_DEMO_MANAGER_ID=BT001
# NEXT_PUBLIC_DEMO_HR_ID=BT000
# NEXT_PUBLIC_DEMO_FINANCE_ID=
